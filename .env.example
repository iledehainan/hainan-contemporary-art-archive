# Local development can omit DATABASE_URL and use data/archive.db.
# In production, set this to the Supabase PostgreSQL connection-pooler URI.
DATABASE_URL=
DB_POOL_SIZE=5

# Keep both blank for local uploads in ./uploads. For persistent production
# uploads, set both on the server and create a private bucket (never expose
# the service-role key in browser code).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=archive-uploads
